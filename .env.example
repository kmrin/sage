# Sage
SAGE_VERSION=0.1.0
SAGE_DEBUG=false
SAGE_HOME=/var/lib/Sage
SAGE_DEFAULT_LOCALE=en-US
SAGE_DEV_GUILD_ID=
TZ=UTC

# Discord
DISCORD_TOKEN=
DISCORD_OWNER_ID=
DISCORD_MESSAGE_CONTENT_INTENT=true

# Database
POSTGRES_HOST=sage-db
POSTGRES_PORT=5432
POSTGRES_DB=sage
POSTGRES_USER=sage
POSTGRES_PASSWORD=change-me

# Lavalink
LAVALINK_HOST=sage-lavalink
LAVALINK_PORT=2333
LAVALINK_PASSWORD=change-me
LAVALINK_MAX_HEAP=512M

# SearXNG. Generate the secret with: openssl rand -hex 32
SEARXNG_URL=http://sage-searxng:8080
SEARXNG_SECRET=change-me
